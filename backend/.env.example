# 应用配置
APP_NAME=家味·Family Chef
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./data/family_chef.db

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 飞书配置
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=

# 文件上传配置
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=5242880  # 5MB

# 智能化功能配置
# 总开关：控制所有智能化功能，设为 false 时所有智能功能都不生效
SMART_ENABLED=false
# 智能食材提取：使用 LLM 从文本中智能识别食材名称、数量和单位
SMART_INGREDIENT_EXTRACTION=false
# LLM 模型配置
LLM_MODEL_REPO=unsloth/Qwen3.5-0.8B-GGUF
LLM_MODEL_FILENAME=Qwen3.5-0.8B-Q4_K_M.gguf
LLM_N_CTX=2048
LLM_N_GPU_LAYERS=0
